#!/bin/bash
# run from current working directory
#$ -cwd
# join stdout and stderr
#$ -j y
#$ -S /bin/bash
# output directory, use the default output filename
# all SGE output files go to the same output directory
#$ -o /nfs/data/agitter/MSG/results/egfr/McKenna2014_061714
# job name
#$ -N mckenna2014
# number of slots to use in the whole_nodes parallel environment
# the whole_nodes pe will allocate all of these slots on a single machine
#$ -pe whole_nodes 4
# Export the environmental variable that set the type of prizes, conf file, beta, mu, and seed in an external script
#$ -v prizetype,conf,beta,mu,seed

echo JOB_ID $JOB_ID
echo JOB_NAME $JOB_NAME
echo NSLOTS $NSLOTS
echo SGE_O_WORKDIR $SGE_O_WORKDIR

codeD=/nfs/data/agitter/MSG/src/protocol/PCSF

prizefile=/nfs/data/agitter/MSG/data/terminal/McKenna2014_aggregated_replicateABC_tukey_${prizetype}_proteinPrizes_firstProtein.txt
edgefile=/nfs/data/agitter/MSG/data/interactome/PhosphoSite_iRefIndex13.0_uniprot_overwrite_pcsf.txt
dummy=/nfs/data/agitter/MSG/data/terminal/McKenna2014_sources.txt
msgpath=/nfs/apps/bin
outpath=/nfs/data/agitter/MSG/results/egfr/McKenna2014_061714/${prizetype}_beta${beta}_mu${mu}
outlabel=McKenna2014_agg_repABC_tukey_${prizetype}_firstProt_seed${seed}
noisyruns=0

# Shouldn't make the directory unless it doesn't already exist
mkdir $outpath

CMD="python $codeD/PCSF.py \
	-p $prizefile \
	-e $edgefile \
	-c $conf \
	-d $dummy \
	--msgpath=$msgpath \
	--outpath=$outpath \
	--outlabel=$outlabel \
	--cyto28 \
	--noisyPrizes=$noisyruns \
	-s $seed"

echo $CMD
$CMD
